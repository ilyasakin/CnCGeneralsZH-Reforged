+/* Zero Hour Reforged: room for a whole bind before any of it is written.  Upstream switched heaps only when one was
+   already full, so a table that did not fit ran past the heap's end (the FIXME below), and a switch between two
+   tables of one draw left the first pointing into the old heaps.  A fresh pair holds any single bind. */
+static bool D3D12_INTERNAL_ZhEnsureGPUDescriptorSpace(
+    D3D12CommandBuffer *commandBuffer,
+    Uint32 viewCount,
+    Uint32 samplerCount)
+{
+    D3D12DescriptorHeap *viewHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV];
+    D3D12DescriptorHeap *samplerHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER];
+
+    if (viewHeap != NULL && samplerHeap != NULL &&
+        viewHeap->currentDescriptorIndex + viewCount <= viewHeap->maxDescriptors &&
+        samplerHeap->currentDescriptorIndex + samplerCount <= samplerHeap->maxDescriptors) {
+        return true;
+    }
+    return D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
