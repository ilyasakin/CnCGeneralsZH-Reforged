+/* Zero Hour Reforged: the most a counter has reached, and one loud line per kind of guard that fired. */
+static bool D3D12_INTERNAL_ZhRaiseMost(SDL_AtomicInt *most, int value)
+{
+    int seen = SDL_GetAtomicInt(most);
+    while (value > seen) {
+        if (SDL_CompareAndSwapAtomicInt(most, seen, value)) {
+            return true;
+        }
+        seen = SDL_GetAtomicInt(most);
+    }
+    return false;
+}
+
+/* A new most of 8, 16, 32 ..., printed as it happens with ZH_SDL_GPU_D3D12_STATS=1: a run that never reaches its
+   destroy line still shows the growth. */
+static void D3D12_INTERNAL_ZhSayMost(Uint32 most, const char *what)
+{
+    if (most >= 8 && (most & (most - 1)) == 0 && SDL_GetHintBoolean("ZH_SDL_GPU_D3D12_STATS", false)) {
+        SDL_Log("D3D12 descriptor heaps: %u %s", most, what);
+    }
+}
+
+typedef enum ZhGuardKind
+{
+    ZH_GUARD_HEAP_FAILURE,
+    ZH_GUARD_LATE_SWITCH,
+    ZH_GUARD_REFUSED_DRAW,
+    ZH_GUARD_REFUSED_DISPATCH
+} ZhGuardKind;
+
+static void D3D12_INTERNAL_ZhGuard(D3D12Renderer *renderer, ZhGuardKind kind, const char *what)
+{
+    if (SDL_CompareAndSwapAtomicInt(&renderer->zhLogged[kind], 0, 1)) {
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "D3D12 descriptor guard: %s (logged once; counted at destroy)", what);
+    }
+}
